{
  "name": "studate-frontend",
  "version": "2.0.0",
  "description": "Frontend de Studate (Grupo 3, EA): la web en React, la app del móvil en Expo y lo que comparten",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @studate/web",
    "dev:movil": "npm run start --workspace @studate/movil",
    "lint": "oxlint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "oxlint": "^1.85.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@expo-google-fonts/material-symbols": "0.4.49",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1"
  }
}
