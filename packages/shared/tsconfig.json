{
  "compilerOptions": {
    "target": "es2023",
    // DOM solo por los tipos de fetch, Response y AbortController, que existen igual en el navegador
    // y en React Native. window, document y localStorage están prohibidos por el linter (.oxlintrc.json)
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
