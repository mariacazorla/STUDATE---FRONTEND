# Plantilla de variables de entorno de la web.
# Cópiala con el nombre .env (cp .env.example .env). Tu .env no se sube a GitHub.

# Dirección de la API. En local es la del backend arrancado con npm run dev.
# En el servidor, la web y la API van detrás del mismo nginx y es /api.
# Sin esta variable se usa http://localhost:1337.
VITE_API_URL=http://localhost:1337
