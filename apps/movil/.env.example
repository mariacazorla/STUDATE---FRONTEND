# Plantilla de variables de entorno de la app del móvil.
# Cópiala con el nombre .env (cp .env.example .env). Tu .env no se sube a GitHub.

# Dirección de la API. Un teléfono con Expo Go no entiende "localhost" (para él, localhost es el
# propio teléfono): hay que poner la IP del ordenador en la red wifi, por ejemplo http://192.168.1.50:1337
# Sin esta variable se usa localhost (o 10.0.2.2 en el emulador de Android).
EXPO_PUBLIC_API_URL=http://192.168.1.XX:1337
